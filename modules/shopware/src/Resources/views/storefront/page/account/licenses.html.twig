{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    <style>
        .lmp-header {
            background: linear-gradient(135deg, #C1165E 0%, #6D5DF6 100%);
            border-radius: 16px;
            padding: 24px 28px;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 24px;
        }
        .lmp-header .lmp-logo {
            flex: 0 0 auto;
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.16);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .lmp-header h1 {
            color: #ffffff;
            font-size: 1.5rem;
            margin: 0;
            letter-spacing: 0.01em;
        }
        .lmp-header p {
            color: rgba(255, 255, 255, 0.85);
            margin: 4px 0 0;
            font-size: 0.925rem;
        }
        .lmp-licenses {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px;
        }
        .lmp-card {
            background: #ffffff;
            border: 1px solid #e8e8ef;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 2px 10px rgba(20, 10, 40, 0.05);
        }
        .lmp-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 12px;
        }
        .lmp-product {
            font-weight: 700;
            font-size: 1.05rem;
            color: #1c1530;
            overflow-wrap: anywhere;
        }
        .lmp-pill {
            flex: 0 0 auto;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 999px;
            white-space: nowrap;
        }
        .lmp-pill-active { background: #e3f6ec; color: #157347; }
        .lmp-pill-inactive { background: #f0f0f5; color: #5a5a6e; }
        .lmp-pill-revoked { background: #fde8e8; color: #b42318; }
        .lmp-pill-expired { background: #fff1d6; color: #8a5a00; }
        .lmp-meta {
            color: #5a5a6e;
            font-size: 0.875rem;
            line-height: 1.7;
            margin: 0 0 14px;
        }
        .lmp-meta strong { color: #1c1530; font-weight: 600; }
        .lmp-key {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f7f5ff;
            border: 1px dashed #c9bfff;
            border-radius: 10px;
            padding: 10px 12px;
        }
        .lmp-key code {
            flex: 1 1 auto;
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.825rem;
            color: #3d2c8d;
            overflow-wrap: anywhere;
            word-break: break-all;
            background: none;
            padding: 0;
        }
        .lmp-copy {
            flex: 0 0 auto;
            border: 0;
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 0.8rem;
            font-weight: 700;
            color: #ffffff;
            background: linear-gradient(135deg, #C1165E 0%, #6D5DF6 100%);
            cursor: pointer;
        }
        .lmp-empty, .lmp-error {
            background: #ffffff;
            border: 1px solid #e8e8ef;
            border-radius: 14px;
            padding: 28px;
            text-align: center;
            color: #5a5a6e;
        }
        .lmp-error { border-color: #f3b8b8; color: #b42318; background: #fff7f7; }
    </style>

    <div class="lmp-header">
        <span class="lmp-logo" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="8" cy="15" r="4.5" stroke="#ffffff" stroke-width="1.8"/>
                <path d="M11.5 12.5 20 4" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round"/>
                <circle cx="17.5" cy="6.5" r="1.6" fill="#ffffff"/>
                <circle cx="20.5" cy="3.5" r="1.6" fill="#ffffff"/>
                <circle cx="8" cy="15" r="1.1" fill="#ffffff"/>
            </svg>
        </span>
        <div>
            <h1>LicenseManagerPro</h1>
            <p>{{ "Your licenses, issued by LicenseManagerPro."|trans }}</p>
        </div>
    </div>

    {% if loadError %}
        <div class="lmp-error">
            {{ "Your licenses could not be loaded right now. Please try again later."|trans }}
        </div>
    {% elseif licenses is empty %}
        <div class="lmp-empty">
            {{ "You do not have any licenses yet. Licenses appear here automatically after a paid order."|trans }}
        </div>
    {% else %}
        <div class="lmp-licenses">
            {% for license in licenses %}
                {% set status = (license.status|default('inactive'))|lower %}
                {% set pillClass = status == 'active' ? 'lmp-pill-active'
                    : status == 'revoked' ? 'lmp-pill-revoked'
                    : status == 'expired' ? 'lmp-pill-expired'
                    : 'lmp-pill-inactive' %}
                <article class="lmp-card">
                    <div class="lmp-card-top">
                        <span class="lmp-product">{{ license.product|default('—') }}</span>
                        <span class="lmp-pill {{ pillClass }}">{{ status }}</span>
                    </div>
                    <p class="lmp-meta">
                        {% if license.billing_cycle %}
                            <strong>{{ "Billing cycle"|trans }}:</strong> {{ license.billing_cycle }}<br>
                        {% endif %}
                        {% if license.expires_at %}
                            <strong>{{ "Expires"|trans }}:</strong> {{ license.expires_at|date('Y-m-d') }}<br>
                        {% endif %}
                        <strong>{{ "Activations"|trans }}:</strong> {{ license.activations|default(0) }} / {{ license.max_activations|default(1) }}
                    </p>
                    <div class="lmp-key">
                        <code>{{ license.key|default('—') }}</code>
                        {% if license.key %}
                            <button type="button" class="lmp-copy" data-lmp-copy="{{ license.key|e('html_attr') }}">{{ "Copy"|trans }}</button>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}

    <script>
        document.querySelectorAll('[data-lmp-copy]').forEach(function (button) {
            var originalLabel = button.textContent;
            button.addEventListener('click', function () {
                var key = button.getAttribute('data-lmp-copy');
                var done = function () {
                    button.textContent = 'Copied';
                    window.setTimeout(function () { button.textContent = originalLabel; }, 1500);
                };
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(key).then(done);
                } else {
                    var area = document.createElement('textarea');
                    area.value = key;
                    document.body.appendChild(area);
                    area.select();
                    document.execCommand('copy');
                    document.body.removeChild(area);
                    done();
                }
            });
        });
    </script>
{% endblock %}
