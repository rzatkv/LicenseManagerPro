{{ header }}
<div id="account-licenses" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <style>
        .lmp-licenses-head{background:linear-gradient(135deg,#C1165E 0%,#6D5DF6 100%);border-radius:12px;padding:18px 22px;color:#fff;margin-bottom:20px;display:flex;align-items:center;gap:14px}
        .lmp-licenses-head h1{margin:0;font-size:22px;font-weight:700;color:#fff}
        .lmp-license-card{border:1px solid #e5e5e5;border-radius:12px;padding:18px;margin-bottom:16px;background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.04)}
        .lmp-license-card h3{margin:0 0 10px;font-size:17px;font-weight:600}
        .lmp-pill{display:inline-block;padding:3px 12px;border-radius:999px;font-size:12px;font-weight:600;text-transform:capitalize}
        .lmp-pill-active{background:#e6f4ea;color:#1e7e34}
        .lmp-pill-expired,.lmp-pill-revoked{background:#fdecea;color:#c0392b}
        .lmp-pill-inactive{background:#f0f0f0;color:#666}
        .lmp-key-chip{display:flex;align-items:center;gap:10px;background:#f7f5ff;border:1px dashed #b9aef7;border-radius:8px;padding:10px 12px;margin:10px 0;font-family:monospace;font-size:14px;word-break:break-all}
        .lmp-key-chip button{flex:0 0 auto}
        .lmp-meta{color:#666;font-size:13px;line-height:1.8}
      </style>

      <div class="lmp-licenses-head">
        <svg width="38" height="38" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <circle cx="24" cy="24" r="22" fill="rgba(255,255,255,0.18)"/>
          <circle cx="18" cy="18" r="7" fill="none" stroke="#fff" stroke-width="3"/>
          <line x1="23.5" y1="23.5" x2="36" y2="36" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
          <circle cx="18" cy="18" r="2.5" fill="#fff"/>
        </svg>
        <h1>{{ heading_title }}</h1>
      </div>

      {% if licenses_error %}
      <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ licenses_error }}</div>
      {% endif %}

      {% if licenses %}
        {% for license in licenses %}
        <div class="lmp-license-card">
          <h3>{{ license.product }}
            <span class="lmp-pill lmp-pill-{{ license.status }}">{{ license.status }}</span>
          </h3>
          <div class="lmp-key-chip">
            <span class="lmp-key-text">{{ license.key }}</span>
            <button type="button" class="btn btn-default btn-sm lmp-copy-btn" data-key="{{ license.key }}">{{ text_copy }}</button>
          </div>
          <div class="lmp-meta">
            {% if license.billing_cycle %}{{ text_billing_cycle }}: {{ license.billing_cycle }}<br />{% endif %}
            {{ text_expires }}: {% if license.expires_at %}{{ license.expires_at }}{% else %}{{ text_never_expires }}{% endif %}<br />
            {% if license.created_at %}{{ text_created }}: {{ license.created_at }}{% endif %}
          </div>
        </div>
        {% endfor %}
      {% else %}
        <p>{{ text_no_licenses }}</p>
      {% endif %}
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
<script type="text/javascript">
document.querySelectorAll('.lmp-copy-btn').forEach(function (button) {
  button.addEventListener('click', function () {
    var key = button.getAttribute('data-key') || '';
    var done = function () {
      button.textContent = '{{ text_copied }}';
      setTimeout(function () { button.textContent = '{{ text_copy }}'; }, 1500);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(key).then(done, done);
    } else {
      var temp = document.createElement('textarea');
      temp.value = key;
      document.body.appendChild(temp);
      temp.select();
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(temp);
      done();
    }
  });
});
</script>
{{ footer }}
