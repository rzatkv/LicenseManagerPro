<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_lmp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.lmp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="LicenseManagerPro" string="LicenseManagerPro" data-key="licensemanagerpro">
                    <h2>LicenseManagerPro</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="lmp_api_url" placeholder="https://licenses.example.com"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="lmp_api_url"/>
                                <div class="text-muted">
                                    Root URL of the LicenseManagerPro panel
                                    (no trailing <code>/api</code> — it is
                                    added automatically).
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="lmp_api_key" widget="password" placeholder="Paste the module API key here"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="lmp_api_key"/>
                                <div class="text-muted">
                                    A module-scoped API key created in the
                                    LicenseManagerPro panel (API Keys — New
                                    Key, scopes licenses + products read).
                                    The secret is shown once in the panel.
                                    No admin e-mail/password is used.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="lmp_sign_requests"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="lmp_sign_requests"/>
                                <div class="text-muted">
                                    Also send X-LMP-Timestamp and
                                    X-LMP-Signature (HMAC-SHA256) with every
                                    request. The server rejects timestamps
                                    older than five minutes.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Calls GET /system/info with the
                                    configured key. A success proves the
                                    URL, the key and the network path.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
