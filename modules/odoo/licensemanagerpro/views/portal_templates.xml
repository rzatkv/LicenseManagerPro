<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal home tile: a "My Licenses" entry on the portal dashboard. -->
    <template id="portal_my_home_lmp" inherit_id="portal.portal_my_home" name="LicenseManagerPro Portal Home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Licenses</t>
                <t t-set="url" t-value="'/my/licenses'"/>
            </t>
        </xpath>
    </template>

    <!-- ==================== My Licenses (list) ==================== -->

    <template id="portal_my_licenses" name="My Licenses">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Licenses</t>
            </t>
            <style>
                .lmp-hero{background:linear-gradient(135deg,#C1165E 0%,#6D5DF6 100%);border-radius:16px;padding:28px 32px;color:#fff;margin-bottom:24px;display:flex;align-items:center;gap:20px}
                .lmp-hero h1{font-size:24px;font-weight:700;margin:0 0 4px;color:#fff}
                .lmp-hero p{margin:0;opacity:.9}
                .lmp-key-badge{background:rgba(255,255,255,.18);border-radius:12px;padding:10px;display:flex;align-items:center;justify-content:center;flex:none}
                .lmp-card{background:#fff;border:1px solid #e8e8ef;border-radius:16px;padding:0;overflow:hidden;box-shadow:0 2px 12px rgba(109,93,246,.08)}
                .lmp-table{width:100%;border-collapse:collapse}
                .lmp-table th{text-align:left;padding:14px 18px;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:#8a8a9e;border-bottom:1px solid #eeeef4}
                .lmp-table td{padding:14px 18px;border-bottom:1px solid #f2f2f7;vertical-align:middle}
                .lmp-table tr:last-child td{border-bottom:none}
                .lmp-key{font-family:ui-monospace,Menlo,Consolas,monospace;word-break:break-all}
                .lmp-pill{display:inline-block;padding:3px 12px;border-radius:999px;font-size:12px;font-weight:600}
                .lmp-pill-active{background:#e6f7ee;color:#157347}
                .lmp-pill-inactive{background:#f1f1f5;color:#5b5b6e}
                .lmp-pill-revoked,.lmp-pill-expired{background:#fdecea;color:#b3261e}
                .lmp-alert{background:#fff4e5;border:1px solid #ffd9a0;color:#7a4a00;border-radius:12px;padding:14px 18px;margin-bottom:20px}
                .lmp-empty{padding:48px 24px;text-align:center;color:#8a8a9e}
                .lmp-empty h3{color:#3d3d52}
            </style>

            <div class="lmp-hero">
                <div class="lmp-key-badge">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"/><path d="M11 12L20 3"/><path d="M16 7l3 3"/><path d="M13.5 9.5l2.5 2.5"/></svg>
                </div>
                <div>
                    <h1>LicenseManagerPro</h1>
                    <p>Your licenses, issued and managed by LicenseManagerPro.</p>
                </div>
            </div>

            <t t-if="error">
                <div class="lmp-alert"><t t-esc="error"/></div>
            </t>

            <div class="lmp-card">
                <t t-if="licenses">
                    <table class="lmp-table">
                        <thead>
                            <tr>
                                <th>License Key</th>
                                <th>Product</th>
                                <th>Billing Cycle</th>
                                <th>Status</th>
                                <th>Expires</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="licenses" t-as="lic">
                                <tr>
                                    <td><span class="lmp-key"><t t-esc="lic.get('key')"/></span></td>
                                    <td><t t-esc="lic.get('product')"/></td>
                                    <td><t t-esc="lic.get('billing_cycle') or '-'"/></td>
                                    <td>
                                        <span t-attf-class="lmp-pill lmp-pill-#{lic.get('status')}">
                                            <t t-esc="lic.get('status')"/>
                                        </span>
                                    </td>
                                    <td><t t-esc="lic.get('expires_at') or 'Never'"/></td>
                                    <td><a t-attf-href="/my/licenses/#{lic.get('id')}">Details</a></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-if="pager">
                        <t t-call="portal.pager"/>
                    </t>
                </t>
                <t t-else="">
                    <div class="lmp-empty">
                        <h3>No licenses yet</h3>
                        <p>Licenses you buy will appear here automatically.</p>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- ================= My License (detail) ================= -->

    <template id="portal_my_license_detail" name="License Details">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">License Details</t>
            </t>
            <style>
                .lmp-hero{background:linear-gradient(135deg,#C1165E 0%,#6D5DF6 100%);border-radius:16px;padding:28px 32px;color:#fff;margin-bottom:24px;display:flex;align-items:center;gap:20px}
                .lmp-hero h1{font-size:24px;font-weight:700;margin:0 0 4px;color:#fff}
                .lmp-hero p{margin:0;opacity:.9}
                .lmp-key-badge{background:rgba(255,255,255,.18);border-radius:12px;padding:10px;display:flex;align-items:center;justify-content:center;flex:none}
                .lmp-card{background:#fff;border:1px solid #e8e8ef;border-radius:16px;padding:24px 28px;box-shadow:0 2px 12px rgba(109,93,246,.08)}
                .lmp-rows{display:grid;grid-template-columns:180px 1fr;gap:12px 20px}
                .lmp-rows dt{color:#8a8a9e;font-weight:600}
                .lmp-rows dd{margin:0;color:#2b2b3d;word-break:break-word}
                .lmp-key{font-family:ui-monospace,Menlo,Consolas,monospace;word-break:break-all}
                .lmp-pill{display:inline-block;padding:3px 12px;border-radius:999px;font-size:12px;font-weight:600}
                .lmp-pill-active{background:#e6f7ee;color:#157347}
                .lmp-pill-inactive{background:#f1f1f5;color:#5b5b6e}
                .lmp-pill-revoked,.lmp-pill-expired{background:#fdecea;color:#b3261e}
                .lmp-back{display:inline-block;margin-top:20px}
            </style>

            <div class="lmp-hero">
                <div class="lmp-key-badge">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"/><path d="M11 12L20 3"/><path d="M16 7l3 3"/><path d="M13.5 9.5l2.5 2.5"/></svg>
                </div>
                <div>
                    <h1>LicenseManagerPro</h1>
                    <p>License details for your purchase.</p>
                </div>
            </div>

            <div class="lmp-card">
                <dl class="lmp-rows">
                    <dt>License Key</dt>
                    <dd><span class="lmp-key"><t t-esc="license.get('key')"/></span></dd>
                    <dt>Product</dt>
                    <dd><t t-esc="license.get('product')"/></dd>
                    <dt>Billing Cycle</dt>
                    <dd><t t-esc="license.get('billing_cycle') or '-'"/></dd>
                    <dt>Status</dt>
                    <dd>
                        <span t-attf-class="lmp-pill lmp-pill-#{license.get('status')}">
                            <t t-esc="license.get('status')"/>
                        </span>
                    </dd>
                    <dt>Expires</dt>
                    <dd><t t-esc="license.get('expires_at') or 'Never'"/></dd>
                    <dt>Activations</dt>
                    <dd><t t-esc="license.get('activations')"/> / <t t-esc="license.get('max_activations')"/></dd>
                    <dt>Owner E-mail</dt>
                    <dd><t t-esc="license.get('owner_email')"/></dd>
                </dl>
            </div>
            <a class="lmp-back" href="/my/licenses">&#8592; Back to My Licenses</a>
        </t>
    </template>
</odoo>
