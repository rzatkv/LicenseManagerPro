<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="4.0" method="upgrade">
    <name>COM_LICENSMANAGERPRO</name>
    <author>LicenseManagerPro</author>
    <creationDate>2026-11-25</creationDate>
    <copyright>(C) 2026 LicenseManagerPro</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>2.3.1</version>
    <description>COM_LICENSMANAGERPRO_XML_DESCRIPTION</description>
    <namespace path="src">Licensemanagerpro\Component\Licensemanagerpro</namespace>

    <files folder="site">
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>
    <languages folder="site/language">
        <language tag="en-GB">en-GB/en-GB.com_licensemanagerpro.ini</language>
    </languages>

    <administration>
        <menu img="class:component">COM_LICENSMANAGERPRO</menu>
        <files folder="administrator">
            <filename>config.xml</filename>
            <folder>services</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <folder>language</folder>
        </files>
        <languages folder="administrator/language">
            <language tag="en-GB">en-GB/en-GB.com_licensemanagerpro.ini</language>
            <language tag="en-GB">en-GB/en-GB.com_licensemanagerpro.sys.ini</language>
        </languages>
    </administration>

    <!--
        Component configuration. Mirrors administrator/config.xml,
        which is what Joomla's Options screen reads after install.
    -->
    <config>
        <fields name="params">
            <fieldset name="basic" label="COM_LICENSMANAGERPRO">
                <field
                    name="api_url"
                    type="url"
                    label="COM_LICENSMANAGERPRO_API_URL"
                    description="COM_LICENSMANAGERPRO_API_URL_DESC"
                    default=""
                    required="true"
                    placeholder="https://license.example.com/api"
                />
                <field
                    name="api_key"
                    type="password"
                    label="COM_LICENSMANAGERPRO_API_KEY"
                    description="COM_LICENSMANAGERPRO_API_KEY_DESC"
                    default=""
                    autocomplete="off"
                />
                <field
                    name="signed_requests"
                    type="radio"
                    label="COM_LICENSMANAGERPRO_SIGNED_REQUESTS"
                    description="COM_LICENSMANAGERPRO_SIGNED_REQUESTS_DESC"
                    default="0"
                    layout="joomla.form.field.radio.switcher"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="default_product_slug"
                    type="text"
                    label="COM_LICENSMANAGERPRO_DEFAULT_PRODUCT_SLUG"
                    description="COM_LICENSMANAGERPRO_DEFAULT_PRODUCT_SLUG_DESC"
                    default=""
                />
                <field
                    name="default_billing_cycle"
                    type="list"
                    label="COM_LICENSMANAGERPRO_DEFAULT_BILLING_CYCLE"
                    description="COM_LICENSMANAGERPRO_DEFAULT_BILLING_CYCLE_DESC"
                    default=""
                >
                    <option value="">COM_LICENSMANAGERPRO_CYCLE_NONE</option>
                    <option value="monthly">monthly</option>
                    <option value="quarterly">quarterly</option>
                    <option value="semiannual">semiannual</option>
                    <option value="annual">annual</option>
                    <option value="biennial">biennial</option>
                    <option value="lifetime">lifetime</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
