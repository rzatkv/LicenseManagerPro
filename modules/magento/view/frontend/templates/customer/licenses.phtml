<div class="lmp-header">
    <svg class="lmp-key-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true">
        <circle cx="24" cy="24" r="22" fill="rgba(255,255,255,0.18)"/>
        <path d="M30 14a8 8 0 1 0 .9 15.95L32 31h2v3h3v3h4v-4h-3v-3h-3v-2.05A8 8 0 0 0 30 14Zm0 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z"
              fill="#ffffff"/>
    </svg>
    <div>
        <h1><?= $block->escapeHtml(__('My Licenses')) ?></h1>
        <p><?= $block->escapeHtml(__('Your License Manager Pro licenses, in one place.')) ?></p>
    </div>
</div>

<?php if ($error): ?>
    <div class="lmp-error"><?= $block->escapeHtml($error) ?></div>
<?php elseif (empty($licenses)): ?>
    <div class="lmp-empty"><?= $block->escapeHtml(__('You do not have any licenses yet.')) ?></div>
<?php else: ?>
    <?php foreach ($licenses as $license): ?>
        <?php
        $status = strtolower((string) ($license['status'] ?? ''));
        $pillClass = 'lmp-pill';
        if ($status === 'active') {
            $pillClass .= ' lmp-pill-active';
        } elseif (in_array($status, ['expired', 'revoked'], true)) {
            $pillClass .= ' lmp-pill-' . $status;
        } elseif ($status === 'suspended') {
            $pillClass .= ' lmp-pill-suspended';
        }
        $key = (string) ($license['license_key'] ?? '');
        $productName = (string) ($license['product_name'] ?? $license['product_slug'] ?? $license['product_id'] ?? '');
        $expires = (string) ($license['expires_at'] ?? $license['expiry'] ?? '');
        $cycle = (string) ($license['billing_cycle'] ?? '');
        ?>
        <div class="lmp-card">
            <div class="lmp-card-head">
                <h2><?= $block->escapeHtml($productName) ?></h2>
                <span class="<?= $block->escapeHtmlAttr($pillClass) ?>">
                    <?= $block->escapeHtml(ucfirst($status)) ?>
                </span>
            </div>
            <?php if ($cycle !== ''): ?>
                <p class="lmp-meta"><?= $block->escapeHtml(__('Billing cycle: %1', $cycle)) ?></p>
            <?php endif; ?>
            <?php if ($expires !== ''): ?>
                <p class="lmp-meta"><?= $block->escapeHtml(__('Expires: %1', $expires)) ?></p>
            <?php endif; ?>
            <?php if ($key !== ''): ?>
                <div class="lmp-key-row">
                    <code class="lmp-key-chip"><?= $block->escapeHtml($key) ?></code>
                    <button type="button" class="lmp-copy-btn"
                            data-lmp-key="<?= $block->escapeHtmlAttr($key) ?>"
                            onclick="lmpCopyKey(this)">
                        <?= $block->escapeHtml(__('Copy')) ?>
                    </button>
                </div>
            <?php endif; ?>
        </div>
    <?php endforeach; ?>
<?php endif; ?>

<script>
    function lmpCopyKey(button) {
        var key = button.getAttribute('data-lmp-key') || '';
        var done = function () { button.textContent = '<?= $block->escapeJs(__('Copied')) ?>'; };
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(key).then(done);
        } else {
            var input = document.createElement('input');
            input.value = key;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            done();
        }
    }
</script>
