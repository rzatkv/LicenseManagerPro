# Copy this file to .env and adjust the values. Never commit a real .env.
# Database: SQLite by default (runs out of the box). For MySQL use:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/license_manager
DATABASE_URL=sqlite:///./license_manager.db

# JWT secret — generate a long random value and keep it private!
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# JWT lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fallback daily request limit for API-key validation (the
# "daily_request_limit" system setting overrides this at runtime).
DAILY_REQUEST_LIMIT=100

# Comma-separated origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Application version shown by GET /api/system/info
APP_VERSION=2.1.0

# Rate limits (requests per minute, per client IP) for the hand-rolled
# sliding-window limiter: auth endpoints (login/register) and validation
# endpoints (license validate, API-key check-access).
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_VALIDATE_PER_MINUTE=60

# Optional SMTP settings for utils.email.send_email (leave empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
